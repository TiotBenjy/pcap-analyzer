{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: native open dialog, and opening the export folder only.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$LOCALDATA/NetSift/exports" },
        { "path": "$LOCALDATA/NetSift/exports/**" }
      ]
    }
  ]
}
