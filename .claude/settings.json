{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./x.sh:*)",
      "Bash(bash x.sh:*)",
      "Bash(scripts/wt.sh:*)",
      "Bash(bash scripts/wt.sh:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(find:*)",
      "Bash(shellcheck:*)"
    ],
    "deny": [
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(gh:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./captures/**)",
      "Read(./.data/**)",
      "Read(./.artifacts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-toolchain.sh"
          }
        ]
      }
    ]
  }
}
