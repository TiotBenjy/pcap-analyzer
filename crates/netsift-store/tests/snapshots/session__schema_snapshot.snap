---
source: crates/netsift-store/tests/session.rs
expression: schema
---
-- table anomalies
CREATE TABLE anomalies (
    id       INTEGER PRIMARY KEY,
    kind     TEXT NOT NULL,
    chunk_id INTEGER,                               -- chunks.id, NULL when not tied to a file
    ts       INTEGER,
    detail   TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(detail))
);

-- index anomalies_chunk_id
CREATE INDEX anomalies_chunk_id ON anomalies (chunk_id);

-- index anomalies_kind
CREATE INDEX anomalies_kind ON anomalies (kind);

-- index anomalies_ts
CREATE INDEX anomalies_ts ON anomalies (coalesce(ts, 9223372036854775807), id);

-- table chunks
CREATE TABLE chunks (
    id         INTEGER PRIMARY KEY,                 -- index in the ordered set (RawPacket.chunk_id)
    seq        INTEGER,                             -- sequence number parsed from the file name
    path       TEXT NOT NULL,
    format     TEXT CHECK (format IN ('pcap', 'pcapng')),
    compressed INTEGER NOT NULL DEFAULT 0 CHECK (compressed IN (0, 1)),
    linktypes  TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(linktypes)),
    snaplen    INTEGER,
    first_ts   INTEGER,
    last_ts    INTEGER,
    packets    INTEGER NOT NULL DEFAULT 0,
    bytes      INTEGER NOT NULL DEFAULT 0,          -- captured packet bytes
    file_size  INTEGER NOT NULL DEFAULT 0,          -- size of the file on disk
    mtime_ns   INTEGER,
    head_hash  TEXT,                                -- hex digest of the first 64 KiB
    status     TEXT NOT NULL DEFAULT 'ok'
               CHECK (status IN ('ok', 'truncated', 'duplicate', 'ignored'))
);

-- index chunks_first_ts
CREATE INDEX chunks_first_ts ON chunks (first_ts);

-- index chunks_seq
CREATE INDEX chunks_seq ON chunks (seq);

-- index chunks_status
CREATE INDEX chunks_status ON chunks (status);

-- table conversations
CREATE TABLE conversations (
    id            INTEGER PRIMARY KEY,
    src_ip        TEXT NOT NULL,                    -- client (initiator)
    dst_ip        TEXT NOT NULL,                    -- server
    first_ts      INTEGER NOT NULL,
    last_ts       INTEGER NOT NULL,
    bytes_fwd     INTEGER NOT NULL DEFAULT 0,       -- src -> dst
    bytes_rev     INTEGER NOT NULL DEFAULT 0,       -- dst -> src
    packets_fwd   INTEGER NOT NULL DEFAULT 0,
    packets_rev   INTEGER NOT NULL DEFAULT 0,
    flows         INTEGER NOT NULL DEFAULT 0,
    dns_bytes_fwd INTEGER NOT NULL DEFAULT 0,       -- part of bytes_fwd carried by DNS flows
    dns_bytes_rev INTEGER NOT NULL DEFAULT 0,       -- part of bytes_rev carried by DNS flows
    dns_flows     INTEGER NOT NULL DEFAULT 0,
    protocols     TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(protocols)),  -- sorted labels
    bytes_total   INTEGER GENERATED ALWAYS AS (bytes_fwd + bytes_rev) VIRTUAL,
    packets_total INTEGER GENERATED ALWAYS AS (packets_fwd + packets_rev) VIRTUAL,
    UNIQUE (src_ip, dst_ip)
);

-- index conversations_bytes
CREATE INDEX conversations_bytes ON conversations (bytes_total);

-- index conversations_bytes_no_dns
CREATE INDEX conversations_bytes_no_dns ON conversations (bytes_fwd + bytes_rev - dns_bytes_fwd - dns_bytes_rev);

-- index conversations_dst_ip
CREATE INDEX conversations_dst_ip ON conversations (dst_ip);

-- index conversations_first_ts
CREATE INDEX conversations_first_ts ON conversations (first_ts);

-- index conversations_flows
CREATE INDEX conversations_flows ON conversations (flows);

-- index conversations_last_ts
CREATE INDEX conversations_last_ts ON conversations (last_ts);

-- index conversations_packets
CREATE INDEX conversations_packets ON conversations (packets_total);

-- table flows
CREATE TABLE flows (
    id            INTEGER PRIMARY KEY,
    transport     INTEGER NOT NULL,                 -- IP protocol number (6 TCP, 17 UDP, 1 ICMP...)
    src_ip        TEXT NOT NULL,
    src_port      INTEGER NOT NULL DEFAULT 0,       -- 0 when the transport has no ports
    dst_ip        TEXT NOT NULL,
    dst_port      INTEGER NOT NULL DEFAULT 0,
    first_ts      INTEGER NOT NULL,
    last_ts       INTEGER NOT NULL,
    bytes_fwd     INTEGER NOT NULL DEFAULT 0,
    bytes_rev     INTEGER NOT NULL DEFAULT 0,
    packets_fwd   INTEGER NOT NULL DEFAULT 0,
    packets_rev   INTEGER NOT NULL DEFAULT 0,
    bytes_total   INTEGER GENERATED ALWAYS AS (bytes_fwd + bytes_rev) VIRTUAL,
    packets_total INTEGER GENERATED ALWAYS AS (packets_fwd + packets_rev) VIRTUAL,
    app_proto     TEXT,
    tcp_state     TEXT
);

-- index flows_app_proto
CREATE INDEX flows_app_proto ON flows (app_proto);

-- index flows_bytes_total
CREATE INDEX flows_bytes_total ON flows (bytes_total);

-- index flows_dst_ip
CREATE INDEX flows_dst_ip ON flows (dst_ip);

-- index flows_dst_port
CREATE INDEX flows_dst_port ON flows (dst_port);

-- index flows_first_ts
CREATE INDEX flows_first_ts ON flows (first_ts);

-- index flows_last_ts
CREATE INDEX flows_last_ts ON flows (last_ts);

-- index flows_packets_total
CREATE INDEX flows_packets_total ON flows (packets_total);

-- index flows_service
CREATE INDEX flows_service ON flows (dst_ip, dst_port, transport, src_ip);

-- index flows_src_ip
CREATE INDEX flows_src_ip ON flows (src_ip);

-- table host_traffic
CREATE TABLE host_traffic (
    ip               TEXT PRIMARY KEY NOT NULL,
    bytes_sent       INTEGER NOT NULL DEFAULT 0,
    bytes_received   INTEGER NOT NULL DEFAULT 0,
    packets_sent     INTEGER NOT NULL DEFAULT 0,
    packets_received INTEGER NOT NULL DEFAULT 0
) WITHOUT ROWID;

-- table hosts
CREATE TABLE hosts (
    ip       TEXT PRIMARY KEY NOT NULL,
    macs     TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(macs)),   -- sorted JSON array
    names    TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(names)),  -- sorted JSON array
    country  TEXT,
    category TEXT,
    first_ts INTEGER NOT NULL,
    last_ts  INTEGER NOT NULL
);

-- index hosts_category
CREATE INDEX hosts_category ON hosts (category);

-- index hosts_country
CREATE INDEX hosts_country ON hosts (country);

-- index hosts_first_ts
CREATE INDEX hosts_first_ts ON hosts (first_ts);

-- index hosts_last_ts
CREATE INDEX hosts_last_ts ON hosts (last_ts);

-- table meta
CREATE TABLE meta (
    key   TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL
) WITHOUT ROWID;

-- table open_ports
CREATE TABLE open_ports (
    ip        TEXT NOT NULL,
    transport INTEGER NOT NULL,                     -- 6 TCP, 17 UDP
    port      INTEGER NOT NULL,
    evidence  TEXT NOT NULL CHECK (evidence IN ('server_data', 'syn_ack', 'udp_reply')),
    service   TEXT,                                 -- IANA service name of the port
    detected  TEXT,                                 -- service identified by content
    banner    TEXT,                                 -- first line of a greeting, <= 256 bytes
    first_ts  INTEGER NOT NULL,
    last_ts   INTEGER NOT NULL,
    PRIMARY KEY (ip, transport, port)
) WITHOUT ROWID;

-- index open_ports_port
CREATE INDEX open_ports_port ON open_ports (port, transport);

-- table schema_migrations
CREATE TABLE schema_migrations (
    version    INTEGER PRIMARY KEY,
    name       TEXT NOT NULL,
    applied_ns INTEGER NOT NULL
);

-- table timeseries
CREATE TABLE timeseries (
    bucket_s INTEGER NOT NULL,                      -- seconds since the Unix epoch
    proto    TEXT NOT NULL,
    bytes    INTEGER NOT NULL DEFAULT 0,
    packets  INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (bucket_s, proto)
) WITHOUT ROWID;

-- index timeseries_proto
CREATE INDEX timeseries_proto ON timeseries (proto, bucket_s);
