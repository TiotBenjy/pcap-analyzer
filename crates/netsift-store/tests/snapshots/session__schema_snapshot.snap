---
source: crates/netsift-store/tests/session.rs
assertion_line: 140
expression: schema
---
-- table anomalies
CREATE TABLE anomalies (
    id       INTEGER PRIMARY KEY,
    kind     TEXT NOT NULL,
    chunk_id INTEGER,                               -- chunks.id, NULL when not tied to a file
    ts       INTEGER,
    detail   TEXT NOT NULL DEFAULT '{}' CHECK (json_valid(detail))
);

-- index anomalies_chunk_id
CREATE INDEX anomalies_chunk_id ON anomalies (chunk_id);

-- index anomalies_kind
CREATE INDEX anomalies_kind ON anomalies (kind);

-- index anomalies_ts
CREATE INDEX anomalies_ts ON anomalies (coalesce(ts, 9223372036854775807), id);

-- table chunks
CREATE TABLE chunks (
    id         INTEGER PRIMARY KEY,                 -- index in the ordered set (RawPacket.chunk_id)
    seq        INTEGER,                             -- sequence number parsed from the file name
    path       TEXT NOT NULL,
    format     TEXT CHECK (format IN ('pcap', 'pcapng')),
    compressed INTEGER NOT NULL DEFAULT 0 CHECK (compressed IN (0, 1)),
    linktypes  TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(linktypes)),
    snaplen    INTEGER,
    first_ts   INTEGER,
    last_ts    INTEGER,
    packets    INTEGER NOT NULL DEFAULT 0,
    bytes      INTEGER NOT NULL DEFAULT 0,          -- captured packet bytes
    file_size  INTEGER NOT NULL DEFAULT 0,          -- size of the file on disk
    mtime_ns   INTEGER,
    head_hash  TEXT,                                -- hex digest of the first 64 KiB
    status     TEXT NOT NULL DEFAULT 'ok'
               CHECK (status IN ('ok', 'truncated', 'duplicate', 'ignored'))
);

-- index chunks_first_ts
CREATE INDEX chunks_first_ts ON chunks (first_ts);

-- index chunks_seq
CREATE INDEX chunks_seq ON chunks (seq);

-- index chunks_status
CREATE INDEX chunks_status ON chunks (status);

-- table conversations
CREATE TABLE conversations (
    id            INTEGER PRIMARY KEY,
    src_ip        TEXT NOT NULL,                    -- client (initiator)
    dst_ip        TEXT NOT NULL,                    -- server
    first_ts      INTEGER NOT NULL,
    last_ts       INTEGER NOT NULL,
    bytes_fwd     INTEGER NOT NULL DEFAULT 0,       -- src -> dst
    bytes_rev     INTEGER NOT NULL DEFAULT 0,       -- dst -> src
    packets_fwd   INTEGER NOT NULL DEFAULT 0,
    packets_rev   INTEGER NOT NULL DEFAULT 0,
    flows         INTEGER NOT NULL DEFAULT 0,
    dns_bytes_fwd INTEGER NOT NULL DEFAULT 0,       -- part of bytes_fwd carried by DNS flows
    dns_bytes_rev INTEGER NOT NULL DEFAULT 0,       -- part of bytes_rev carried by DNS flows
    dns_flows     INTEGER NOT NULL DEFAULT 0,
    protocols     TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(protocols)),  -- sorted labels
    bytes_total   INTEGER GENERATED ALWAYS AS (bytes_fwd + bytes_rev) VIRTUAL,
    packets_total INTEGER GENERATED ALWAYS AS (packets_fwd + packets_rev) VIRTUAL,
    UNIQUE (src_ip, dst_ip)
);

-- index conversations_bytes
CREATE INDEX conversations_bytes ON conversations (bytes_total);

-- index conversations_bytes_no_dns
CREATE INDEX conversations_bytes_no_dns ON conversations (bytes_fwd + bytes_rev - dns_bytes_fwd - dns_bytes_rev);

-- index conversations_dst_ip
CREATE INDEX conversations_dst_ip ON conversations (dst_ip);

-- index conversations_first_ts
CREATE INDEX conversations_first_ts ON conversations (first_ts);

-- index conversations_flows
CREATE INDEX conversations_flows ON conversations (flows);

-- index conversations_last_ts
CREATE INDEX conversations_last_ts ON conversations (last_ts);

-- index conversations_packets
CREATE INDEX conversations_packets ON conversations (packets_total);

-- table dhcp_messages
CREATE TABLE dhcp_messages (
    id           INTEGER PRIMARY KEY,
    ts           INTEGER NOT NULL,
    src_ip       TEXT NOT NULL,
    dst_ip       TEXT NOT NULL,
    op           INTEGER NOT NULL CHECK (op IN (1, 2)),   -- 1 request, 2 reply
    msg_type     TEXT,                                    -- discover, offer, request, ack...; NULL: BOOTP
    xid          INTEGER NOT NULL,
    client_mac   TEXT,                                    -- aa:bb:cc:dd:ee:ff (Ethernet only)
    ciaddr       TEXT,
    yiaddr       TEXT,                                    -- address offered / leased
    siaddr       TEXT,
    giaddr       TEXT,                                    -- relay agent
    server_id    TEXT,                                    -- option 54
    requested_ip TEXT,                                    -- option 50
    subnet_mask  TEXT,                                    -- option 1
    routers      TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(routers)),     -- option 3
    dns_servers  TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(dns_servers)), -- option 6
    lease_s      INTEGER,                                 -- option 51
    hostname     TEXT,                                    -- option 12
    -- The DHCP server: its identifier when announced, else the sender.
    server_ip    TEXT GENERATED ALWAYS AS (coalesce(server_id, src_ip)) VIRTUAL
);

-- index dhcp_messages_server
CREATE INDEX dhcp_messages_server ON dhcp_messages (op, msg_type, server_ip, ts);

-- index dhcp_messages_ts
CREATE INDEX dhcp_messages_ts ON dhcp_messages (ts);

-- index dhcp_messages_xid
CREATE INDEX dhcp_messages_xid ON dhcp_messages (xid, client_mac);

-- table dns_fts
CREATE VIRTUAL TABLE dns_fts USING fts5 (
    qname, client_ip, server_ip, responder_ip, answers_text,
    content = 'dns_messages', content_rowid = 'id', tokenize = 'trigram'
);

-- table dns_fts_config
CREATE TABLE 'dns_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;

-- table dns_fts_data
CREATE TABLE 'dns_fts_data'(id INTEGER PRIMARY KEY, block BLOB);

-- table dns_fts_docsize
CREATE TABLE 'dns_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);

-- table dns_fts_idx
CREATE TABLE 'dns_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;

-- table dns_messages
CREATE TABLE dns_messages (
    id           INTEGER PRIMARY KEY,
    ts           INTEGER NOT NULL,                  -- query time, or response time without query
    flow_id      INTEGER,                           -- flows.id
    transport    INTEGER NOT NULL,                  -- 6 TCP, 17 UDP
    proto        TEXT NOT NULL CHECK (proto IN ('dns', 'mdns', 'llmnr', 'nbns')),
    client_ip    TEXT NOT NULL,
    client_port  INTEGER NOT NULL,
    server_ip    TEXT NOT NULL,                     -- query destination (possibly a group address)
    server_port  INTEGER NOT NULL,
    responder_ip TEXT,                              -- sender of the response when not server_ip
    txid         INTEGER NOT NULL,
    opcode       TEXT NOT NULL,
    qname        TEXT NOT NULL DEFAULT '',
    qtype        TEXT NOT NULL DEFAULT '',
    nb_suffix    INTEGER,                           -- NetBIOS name suffix (NBNS)
    flags        INTEGER NOT NULL DEFAULT 0,
    rcode        TEXT,                              -- NOERROR, NXDOMAIN..., 'timeout', NULL: none expected
    latency_ns   INTEGER,
    answers      TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(answers)), -- [{n, t, v, ttl}]
    answers_text TEXT NOT NULL DEFAULT '',          -- owner names and values, space separated (search)
    has_query    INTEGER NOT NULL CHECK (has_query IN (0, 1)),
    has_response INTEGER NOT NULL CHECK (has_response IN (0, 1)),
    pending      INTEGER NOT NULL DEFAULT 0 CHECK (pending IN (0, 1)),
    pair_id      INTEGER,                           -- dns_pairs.id
    is_error     INTEGER GENERATED ALWAYS AS (rcode IS NOT NULL AND rcode <> 'NOERROR') VIRTUAL
);

-- index dns_messages_latency
CREATE INDEX dns_messages_latency ON dns_messages (latency_ns) WHERE latency_ns IS NOT NULL;

-- index dns_messages_pair_ts
CREATE INDEX dns_messages_pair_ts ON dns_messages (pair_id, ts);

-- index dns_messages_pairing
CREATE INDEX dns_messages_pairing ON dns_messages (client_ip, client_port, txid, proto, transport, ts);

-- index dns_messages_pending
CREATE INDEX dns_messages_pending ON dns_messages (ts) WHERE pending = 1;

-- index dns_messages_proto_error
CREATE INDEX dns_messages_proto_error ON dns_messages (proto, is_error);

-- index dns_messages_qtype
CREATE INDEX dns_messages_qtype ON dns_messages (qtype, has_query);

-- index dns_messages_rcode
CREATE INDEX dns_messages_rcode ON dns_messages (rcode);

-- index dns_messages_responder
CREATE INDEX dns_messages_responder ON dns_messages
    (proto, has_response, coalesce(responder_ip, server_ip), client_ip, ts, latency_ns);

-- index dns_messages_ts
CREATE INDEX dns_messages_ts ON dns_messages (ts);

-- table dns_pairs
CREATE TABLE dns_pairs (
    id         INTEGER PRIMARY KEY,                 -- deterministic: order of (proto, client, server)
    proto      TEXT NOT NULL,
    client_ip  TEXT NOT NULL,
    server_ip  TEXT NOT NULL,
    messages   INTEGER NOT NULL,
    errors     INTEGER NOT NULL,
    names      INTEGER NOT NULL,                    -- distinct query names
    top_names  TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(top_names)), -- 5 most frequent names
    first_ts   INTEGER NOT NULL,
    last_ts    INTEGER NOT NULL,
    UNIQUE (proto, client_ip, server_ip)
);

-- index dns_pairs_messages
CREATE INDEX dns_pairs_messages ON dns_pairs (messages, id);

-- index dns_pairs_proto_messages
CREATE INDEX dns_pairs_proto_messages ON dns_pairs (proto, messages, id);

-- index dns_pairs_server
CREATE INDEX dns_pairs_server ON dns_pairs (server_ip);

-- table flows
CREATE TABLE flows (
    id            INTEGER PRIMARY KEY,
    transport     INTEGER NOT NULL,                 -- IP protocol number (6 TCP, 17 UDP, 1 ICMP...)
    src_ip        TEXT NOT NULL,
    src_port      INTEGER NOT NULL DEFAULT 0,       -- 0 when the transport has no ports
    dst_ip        TEXT NOT NULL,
    dst_port      INTEGER NOT NULL DEFAULT 0,
    first_ts      INTEGER NOT NULL,
    last_ts       INTEGER NOT NULL,
    bytes_fwd     INTEGER NOT NULL DEFAULT 0,
    bytes_rev     INTEGER NOT NULL DEFAULT 0,
    packets_fwd   INTEGER NOT NULL DEFAULT 0,
    packets_rev   INTEGER NOT NULL DEFAULT 0,
    bytes_total   INTEGER GENERATED ALWAYS AS (bytes_fwd + bytes_rev) VIRTUAL,
    packets_total INTEGER GENERATED ALWAYS AS (packets_fwd + packets_rev) VIRTUAL,
    app_proto     TEXT,
    tcp_state     TEXT
);

-- index flows_app_proto
CREATE INDEX flows_app_proto ON flows (app_proto);

-- index flows_bytes_total
CREATE INDEX flows_bytes_total ON flows (bytes_total);

-- index flows_dst_ip
CREATE INDEX flows_dst_ip ON flows (dst_ip);

-- index flows_dst_port
CREATE INDEX flows_dst_port ON flows (dst_port);

-- index flows_first_ts
CREATE INDEX flows_first_ts ON flows (first_ts);

-- index flows_last_ts
CREATE INDEX flows_last_ts ON flows (last_ts);

-- index flows_packets_total
CREATE INDEX flows_packets_total ON flows (packets_total);

-- index flows_service
CREATE INDEX flows_service ON flows (dst_ip, dst_port, transport, src_ip);

-- index flows_src_ip
CREATE INDEX flows_src_ip ON flows (src_ip);

-- table host_traffic
CREATE TABLE host_traffic (
    ip               TEXT PRIMARY KEY NOT NULL,
    bytes_sent       INTEGER NOT NULL DEFAULT 0,
    bytes_received   INTEGER NOT NULL DEFAULT 0,
    packets_sent     INTEGER NOT NULL DEFAULT 0,
    packets_received INTEGER NOT NULL DEFAULT 0
) WITHOUT ROWID;

-- table hosts
CREATE TABLE hosts (
    ip       TEXT PRIMARY KEY NOT NULL,
    macs     TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(macs)),   -- sorted JSON array
    names    TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(names)),  -- sorted JSON array
    country  TEXT,
    category TEXT,
    first_ts INTEGER NOT NULL,
    last_ts  INTEGER NOT NULL
);

-- index hosts_category
CREATE INDEX hosts_category ON hosts (category);

-- index hosts_country
CREATE INDEX hosts_country ON hosts (country);

-- index hosts_first_ts
CREATE INDEX hosts_first_ts ON hosts (first_ts);

-- index hosts_last_ts
CREATE INDEX hosts_last_ts ON hosts (last_ts);

-- trigger http_headers_fts_insert
CREATE TRIGGER http_headers_fts_insert AFTER INSERT ON http_headers BEGIN
    INSERT INTO http_headers_fts (rowid, name, value) VALUES (new.id, new.name, new.value);
END;

-- table http_headers
CREATE TABLE http_headers (
    id             INTEGER PRIMARY KEY,
    transaction_id INTEGER NOT NULL REFERENCES http_transactions (id),
    direction      TEXT NOT NULL CHECK (direction IN ('request', 'response')),
    idx            INTEGER NOT NULL,
    name           TEXT NOT NULL,                       -- as sent
    name_lc        TEXT NOT NULL,                       -- lower case, for filters and counts
    value          TEXT NOT NULL
);

-- index http_headers_name
CREATE INDEX http_headers_name ON http_headers (name_lc, transaction_id);

-- index http_headers_transaction
CREATE INDEX http_headers_transaction ON http_headers (transaction_id, direction, idx);

-- table http_headers_fts
CREATE VIRTUAL TABLE http_headers_fts USING fts5 (
    name, value,
    content = 'http_headers', content_rowid = 'id', tokenize = 'trigram'
);

-- table http_headers_fts_config
CREATE TABLE 'http_headers_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;

-- table http_headers_fts_data
CREATE TABLE 'http_headers_fts_data'(id INTEGER PRIMARY KEY, block BLOB);

-- table http_headers_fts_docsize
CREATE TABLE 'http_headers_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);

-- table http_headers_fts_idx
CREATE TABLE 'http_headers_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;

-- trigger http_transactions_fts_insert
CREATE TRIGGER http_transactions_fts_insert AFTER INSERT ON http_transactions BEGIN
    INSERT INTO http_transactions_fts (rowid, host, uri, user_agent)
    VALUES (new.id, new.host, new.uri, new.user_agent);
END;

-- table http_transactions
CREATE TABLE http_transactions (
    id              INTEGER PRIMARY KEY,
    flow_id         INTEGER NOT NULL,                   -- flows.id
    seq             INTEGER NOT NULL,                   -- order in the connection
    client_ip       TEXT NOT NULL,
    client_port     INTEGER NOT NULL,
    server_ip       TEXT NOT NULL,
    server_port     INTEGER NOT NULL,
    ts              INTEGER NOT NULL,                   -- request time, else response time
    end_ts          INTEGER NOT NULL,                   -- last byte of the transaction
    method          TEXT,
    method_group    TEXT NOT NULL,                      -- GET...CONNECT, else 'other'
    uri             TEXT,                               -- request target as sent
    host            TEXT,
    path            TEXT,
    query           TEXT,
    version         TEXT,                               -- 'HTTP/1.1', request else response
    status          INTEGER,
    status_key      INTEGER NOT NULL,                   -- status, -1 without response (sort key)
    status_class    TEXT NOT NULL,                      -- '1xx'..'5xx', 'other', 'none'
    reason          TEXT,
    content_type    TEXT,                               -- response media type
    user_agent      TEXT,
    referer         TEXT,
    req_ts          INTEGER,
    req_frame       INTEGER,
    req_head_len    INTEGER,
    req_body_wire   INTEGER,
    req_body_len    INTEGER,
    req_body_state  TEXT,
    req_chunked     INTEGER CHECK (req_chunked IN (0, 1)),
    req_encoding    TEXT,
    req_content_type TEXT,
    req_mime_magic  TEXT,
    req_sha256      TEXT,
    req_preview     TEXT,
    resp_ts         INTEGER,
    resp_frame      INTEGER,
    resp_head_len   INTEGER,
    resp_body_wire  INTEGER,
    resp_body_len   INTEGER NOT NULL DEFAULT 0,         -- 0 without response (sort key)
    resp_body_state TEXT,
    resp_chunked    INTEGER CHECK (resp_chunked IN (0, 1)),
    resp_encoding   TEXT,
    resp_mime_magic TEXT,
    resp_sha256     TEXT,
    resp_preview    TEXT,
    UNIQUE (flow_id, seq)
);

-- index http_transactions_content_type
CREATE INDEX http_transactions_content_type ON http_transactions (content_type);

-- index http_transactions_host
CREATE INDEX http_transactions_host ON http_transactions (host);

-- index http_transactions_method_group
CREATE INDEX http_transactions_method_group ON http_transactions (method_group);

-- index http_transactions_resp_sha256
CREATE INDEX http_transactions_resp_sha256 ON http_transactions (resp_sha256);

-- index http_transactions_server
CREATE INDEX http_transactions_server ON http_transactions (server_ip, client_ip, resp_ts)
    WHERE resp_ts IS NOT NULL;

-- index http_transactions_size
CREATE INDEX http_transactions_size ON http_transactions (resp_body_len);

-- index http_transactions_status
CREATE INDEX http_transactions_status ON http_transactions (status_key);

-- index http_transactions_status_class
CREATE INDEX http_transactions_status_class ON http_transactions (status_class);

-- index http_transactions_ts
CREATE INDEX http_transactions_ts ON http_transactions (ts);

-- index http_transactions_user_agent
CREATE INDEX http_transactions_user_agent ON http_transactions (user_agent);

-- table http_transactions_fts
CREATE VIRTUAL TABLE http_transactions_fts USING fts5 (
    host, uri, user_agent,
    content = 'http_transactions', content_rowid = 'id', tokenize = 'trigram'
);

-- table http_transactions_fts_config
CREATE TABLE 'http_transactions_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;

-- table http_transactions_fts_data
CREATE TABLE 'http_transactions_fts_data'(id INTEGER PRIMARY KEY, block BLOB);

-- table http_transactions_fts_docsize
CREATE TABLE 'http_transactions_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);

-- table http_transactions_fts_idx
CREATE TABLE 'http_transactions_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;

-- table kerberos_replies
CREATE TABLE kerberos_replies (
    server_ip  TEXT NOT NULL,
    client_ip  TEXT NOT NULL,
    kind       TEXT NOT NULL CHECK (kind IN ('as_rep', 'tgs_rep', 'error')),
    replies    INTEGER NOT NULL DEFAULT 0,
    realm      TEXT,
    error_code INTEGER,
    first_ts   INTEGER NOT NULL,
    last_ts    INTEGER NOT NULL,
    PRIMARY KEY (server_ip, client_ip, kind)
) WITHOUT ROWID;

-- index kerberos_replies_last_ts
CREATE INDEX kerberos_replies_last_ts ON kerberos_replies (server_ip, kind, last_ts);

-- table meta
CREATE TABLE meta (
    key   TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL
) WITHOUT ROWID;

-- table ntp_responses
CREATE TABLE ntp_responses (
    server_ip TEXT NOT NULL,
    client_ip TEXT NOT NULL,
    responses INTEGER NOT NULL DEFAULT 0,
    version   INTEGER NOT NULL,
    stratum   INTEGER NOT NULL,
    reference TEXT NOT NULL DEFAULT '',
    first_ts  INTEGER NOT NULL,
    last_ts   INTEGER NOT NULL,
    PRIMARY KEY (server_ip, client_ip)
) WITHOUT ROWID;

-- index ntp_responses_last_ts
CREATE INDEX ntp_responses_last_ts ON ntp_responses (server_ip, last_ts);

-- table open_ports
CREATE TABLE open_ports (
    ip        TEXT NOT NULL,
    transport INTEGER NOT NULL,                     -- 6 TCP, 17 UDP
    port      INTEGER NOT NULL,
    evidence  TEXT NOT NULL CHECK (evidence IN ('server_data', 'syn_ack', 'udp_reply')),
    service   TEXT,                                 -- IANA service name of the port
    detected  TEXT,                                 -- service identified by content
    banner    TEXT,                                 -- first line of a greeting, <= 256 bytes
    first_ts  INTEGER NOT NULL,
    last_ts   INTEGER NOT NULL,
    PRIMARY KEY (ip, transport, port)
) WITHOUT ROWID;

-- index open_ports_port
CREATE INDEX open_ports_port ON open_ports (port, transport);

-- table schema_migrations
CREATE TABLE schema_migrations (
    version    INTEGER PRIMARY KEY,
    name       TEXT NOT NULL,
    applied_ns INTEGER NOT NULL
);

-- view server_evidence
CREATE VIEW server_evidence (role, ip, kind, count, clients, first_ts, last_ts, example) AS
WITH srv AS (
    -- SRV answers that locate LDAP, global catalog and Kerberos services: owner and target
    -- (the last word of the value `priority weight port target`).
    SELECT owner, lower(substr(v, length(rtrim(v, replace(v, ' ', ''))) + 1)) AS target, ts
    FROM (SELECT lower(json_extract(a.value, '$.n')) AS owner, json_extract(a.value, '$.v') AS v,
                 m.ts + coalesce(m.latency_ns, 0) AS ts
          FROM dns_messages m, json_each(m.answers) a
          WHERE m.qtype = 'SRV' AND m.has_response = 1 AND json_extract(a.value, '$.t') = 'SRV')
    WHERE owner LIKE '\_ldap.\_tcp.%' ESCAPE '\' OR owner LIKE '\_gc.\_tcp.%' ESCAPE '\'
       OR owner LIKE '\_kerberos.\_tcp.%' ESCAPE '\' OR owner LIKE '\_kerberos.\_udp.%' ESCAPE '\'
),
named AS (
    -- Hosts whose learned names include an SRV target.
    SELECT h.ip, lower(n.value) AS name
    FROM hosts h, json_each(h.names) n
    WHERE h.names <> '[]' AND lower(n.value) IN (SELECT target FROM srv)
)
-- DNS: unicast DNS responses sent (the responder of a query, else its destination).
SELECT 'dns', coalesce(responder_ip, server_ip), 'dns_response', count(*),
       count(DISTINCT client_ip), min(ts + coalesce(latency_ns, 0)),
       max(ts + coalesce(latency_ns, 0)), NULL
FROM dns_messages
WHERE proto = 'dns' AND has_response = 1
GROUP BY coalesce(responder_ip, server_ip)
UNION ALL
-- Services of the roles seen answering on their well-known ports (open_ports), with the flows
-- that reached them.
SELECT CASE o.port WHEN 53 THEN 'dns' WHEN 67 THEN 'dhcp' WHEN 88 THEN 'kerberos'
                   WHEN 123 THEN 'ntp' WHEN 139 THEN 'smb' WHEN 445 THEN 'smb' ELSE 'ldap' END,
       o.ip, 'open_port',
       (SELECT count(*) FROM flows f
        WHERE f.dst_ip = o.ip AND f.dst_port = o.port AND f.transport = o.transport),
       (SELECT count(DISTINCT f.src_ip) FROM flows f
        WHERE f.dst_ip = o.ip AND f.dst_port = o.port AND f.transport = o.transport),
       o.first_ts, o.last_ts,
       o.port || '/' || CASE o.transport WHEN 6 THEN 'tcp' WHEN 17 THEN 'udp'
                                         ELSE o.transport END
FROM open_ports o
WHERE o.port IN (53, 67, 88, 123, 139, 389, 445, 636, 3268, 3269)
UNION ALL
-- DHCP: OFFER, ACK and NAK sent; the example is the address of the latest one.
SELECT 'dhcp', d.server_ip, 'dhcp_' || d.msg_type, count(*), count(DISTINCT d.client_mac),
       min(d.ts), max(d.ts),
       (SELECT x.yiaddr FROM dhcp_messages x
        WHERE x.op = 2 AND x.msg_type = d.msg_type AND x.server_ip = d.server_ip
        ORDER BY x.ts DESC, x.yiaddr DESC LIMIT 1)
FROM dhcp_messages d
WHERE d.op = 2 AND d.msg_type IN ('offer', 'ack', 'nak')
GROUP BY d.server_ip, d.msg_type
UNION ALL
-- LDAP and Kerberos located by DNS SRV records (target name learned by a host).
SELECT CASE WHEN s.owner LIKE '\_kerberos.%' ESCAPE '\' THEN 'kerberos' ELSE 'ldap' END,
       n.ip, 'dns_srv', count(*), NULL, min(s.ts), max(s.ts), min(s.owner)
FROM srv s JOIN named n ON n.name = s.target
GROUP BY 1, n.ip
UNION ALL
-- NTP: server responses; the example is the reference of the latest one.
SELECT 'ntp', t.server_ip, 'ntp_response', sum(t.responses), count(*), min(t.first_ts),
       max(t.last_ts),
       (SELECT 'stratum ' || x.stratum || coalesce(nullif(', ' || x.reference, ', '), '')
        FROM ntp_responses x WHERE x.server_ip = t.server_ip
        ORDER BY x.last_ts DESC, x.stratum DESC, x.reference DESC LIMIT 1)
FROM ntp_responses t
GROUP BY t.server_ip
UNION ALL
-- Kerberos: KDC replies; the example is the realm of the latest one.
SELECT 'kerberos', k.server_ip, 'kdc_' || k.kind, sum(k.replies), count(*), min(k.first_ts),
       max(k.last_ts),
       (SELECT x.realm FROM kerberos_replies x
        WHERE x.server_ip = k.server_ip AND x.kind = k.kind AND x.realm IS NOT NULL
        ORDER BY x.last_ts DESC, x.realm DESC LIMIT 1)
FROM kerberos_replies k
GROUP BY k.server_ip, k.kind
UNION ALL
-- SMB: sessions served (example: highest dialect label).
SELECT 'smb', server_ip, 'smb_session', count(*), count(DISTINCT client_ip), min(first_ts),
       max(last_ts), max(dialect)
FROM smb_sessions
GROUP BY server_ip
UNION ALL
-- SMB: browser announcements of the server service, domain controllers apart
-- (SV_TYPE_SERVER 0x2, SV_TYPE_DOMAIN_CTRL 0x8, SV_TYPE_DOMAIN_BAKCTRL 0x10).
SELECT 'smb', src_ip, CASE WHEN server_type & 24 <> 0 THEN 'browser_dc' ELSE 'browser_server' END,
       sum(announce_count), NULL, min(first_ts), max(last_ts), min(server_name)
FROM smb_announces
WHERE server_type & 26 <> 0
GROUP BY src_ip, 3
UNION ALL
-- HTTP: responses sent.
SELECT 'http', server_ip, 'http_response', count(*), count(DISTINCT client_ip), min(resp_ts),
       max(resp_ts), NULL
FROM http_transactions
WHERE resp_ts IS NOT NULL
GROUP BY server_ip;

-- view server_roles
CREATE VIEW server_roles (role, ip) AS
    SELECT DISTINCT role, ip FROM server_evidence;

-- table smb_announces
CREATE TABLE smb_announces (
    src_ip         TEXT NOT NULL,                     -- address that announced
    server_name    TEXT NOT NULL,                     -- announced computer name
    dst_name       TEXT NOT NULL,                     -- NetBIOS destination (workgroup<suffix>)
    kind           TEXT NOT NULL DEFAULT 'host',      -- host / local_master / domain
    os_major       INTEGER NOT NULL DEFAULT 0,
    os_minor       INTEGER NOT NULL DEFAULT 0,
    os_label       TEXT NOT NULL DEFAULT '',          -- readable OS version
    server_type    INTEGER NOT NULL DEFAULT 0,        -- SV_TYPE_* role bit field
    comment        TEXT NOT NULL DEFAULT '',
    announce_count INTEGER NOT NULL DEFAULT 1,
    first_ts       INTEGER NOT NULL,
    last_ts        INTEGER NOT NULL,
    PRIMARY KEY (src_ip, server_name, dst_name)
);

-- index smb_announces_last_ts
CREATE INDEX smb_announces_last_ts ON smb_announces (last_ts, src_ip);

-- index smb_announces_os
CREATE INDEX smb_announces_os ON smb_announces (kind, os_label, server_name);

-- view smb_items
CREATE VIEW smb_items (kind) AS
    SELECT 'announce' FROM smb_announces
    UNION ALL
    SELECT 'session' FROM smb_sessions;

-- table smb_sessions
CREATE TABLE smb_sessions (
    flow_id     INTEGER PRIMARY KEY,                 -- flows.id
    client_ip   TEXT NOT NULL,
    client_port INTEGER NOT NULL DEFAULT 0,
    server_ip   TEXT NOT NULL,
    server_port INTEGER NOT NULL DEFAULT 0,
    first_ts    INTEGER NOT NULL,
    last_ts     INTEGER NOT NULL,
    protocol    TEXT NOT NULL DEFAULT 'smb2',        -- smb1 / smb2
    dialect     TEXT,                                -- negotiated dialect label
    signing     TEXT NOT NULL DEFAULT 'unknown',     -- disabled / enabled / required / unknown
    server_guid TEXT,                                -- lower-case hex of the SMB2 server GUID
    domain      TEXT,                                -- NTLM account domain
    account     TEXT,                                -- NTLM account name
    workstation TEXT,                                -- NTLM workstation name
    ntlm_phase  TEXT                                 -- negotiate / challenge / authenticate
);

-- index smb_sessions_account
CREATE INDEX smb_sessions_account ON smb_sessions (account);

-- index smb_sessions_first_ts
CREATE INDEX smb_sessions_first_ts ON smb_sessions (first_ts, flow_id);

-- index smb_sessions_ntlm_phase
CREATE INDEX smb_sessions_ntlm_phase ON smb_sessions (ntlm_phase);

-- index smb_sessions_server_ip
CREATE INDEX smb_sessions_server_ip ON smb_sessions (server_ip);

-- table timeseries
CREATE TABLE timeseries (
    bucket_s INTEGER NOT NULL,                      -- seconds since the Unix epoch
    proto    TEXT NOT NULL,
    bytes    INTEGER NOT NULL DEFAULT 0,
    packets  INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (bucket_s, proto)
) WITHOUT ROWID;

-- index timeseries_proto
CREATE INDEX timeseries_proto ON timeseries (proto, bucket_s);

-- table tls_certificates
CREATE TABLE tls_certificates (
    sha256          TEXT PRIMARY KEY NOT NULL,      -- hex, name of the blob
    sha1            TEXT NOT NULL,
    size            INTEGER NOT NULL,
    stored          INTEGER NOT NULL DEFAULT 0 CHECK (stored IN (0, 1)), -- DER blob written
    parsed          INTEGER NOT NULL DEFAULT 1 CHECK (parsed IN (0, 1)),
    subject         TEXT,
    subject_cn      TEXT,
    issuer          TEXT,
    issuer_cn       TEXT,
    serial          TEXT,                           -- hex
    not_before      INTEGER,                        -- ns
    not_after       INTEGER,                        -- ns
    san             TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(san)),
    key_algorithm   TEXT,
    key_bits        INTEGER,
    signature_algorithm TEXT,
    self_signed     INTEGER NOT NULL DEFAULT 0 CHECK (self_signed IN (0, 1)),
    is_ca           INTEGER NOT NULL DEFAULT 0 CHECK (is_ca IN (0, 1))
) WITHOUT ROWID;

-- index tls_certificates_not_after
CREATE INDEX tls_certificates_not_after ON tls_certificates (not_after);

-- index tls_certificates_subject_cn
CREATE INDEX tls_certificates_subject_cn ON tls_certificates (lower(coalesce(subject_cn, '')), sha256);

-- table tls_cipher_suites
CREATE TABLE tls_cipher_suites (
    id   INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    weak TEXT
);

-- table tls_client_hellos
CREATE TABLE tls_client_hellos (
    session_id         INTEGER PRIMARY KEY,         -- tls_sessions.id
    legacy_version     INTEGER NOT NULL,
    random             TEXT NOT NULL,               -- hex
    session_ticket     INTEGER NOT NULL DEFAULT 0 CHECK (session_ticket IN (0, 1)),
    legacy_session_id  TEXT NOT NULL DEFAULT '',    -- hex
    cipher_suites      TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(cipher_suites)),
    compressions       TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(compressions)),
    extensions         TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(extensions)),
    groups             TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(groups)),
    point_formats      TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(point_formats)),
    signature_algs     TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(signature_algs)),
    supported_versions TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(supported_versions)),
    key_share_groups   TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(key_share_groups))
);

-- table tls_server_hellos
CREATE TABLE tls_server_hellos (
    session_id        INTEGER PRIMARY KEY,          -- tls_sessions.id
    legacy_version    INTEGER NOT NULL,
    random            TEXT NOT NULL,                -- hex
    legacy_session_id TEXT NOT NULL DEFAULT '',     -- hex
    cipher_suite      INTEGER NOT NULL,
    compression       INTEGER NOT NULL,
    extensions        TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(extensions)),
    selected_version  INTEGER                       -- supported_versions extension (TLS 1.3)
);

-- table tls_session_certificates
CREATE TABLE tls_session_certificates (
    session_id INTEGER NOT NULL,                    -- tls_sessions.id
    position   INTEGER NOT NULL,
    sha256     TEXT NOT NULL,                       -- tls_certificates.sha256
    PRIMARY KEY (session_id, position)
) WITHOUT ROWID;

-- index tls_session_certificates_sha256
CREATE INDEX tls_session_certificates_sha256 ON tls_session_certificates (sha256, session_id);

-- table tls_sessions
CREATE TABLE tls_sessions (
    id              INTEGER PRIMARY KEY,            -- flows.id of the TCP flow
    ts              INTEGER NOT NULL,               -- packet time of the first handshake message
    client_ip       TEXT NOT NULL,
    client_port     INTEGER NOT NULL,
    server_ip       TEXT NOT NULL,
    server_port     INTEGER NOT NULL,
    sni             TEXT,
    offered_version INTEGER,                        -- highest version offered (supported_versions included)
    version         INTEGER,                        -- negotiated version, NULL without ServerHello
    cipher_suite    INTEGER,                        -- negotiated suite, NULL without ServerHello
    cipher_name     TEXT,
    cipher_weak     TEXT,                           -- weakness of the suite (rc4, 3des, null...), NULL if none
    alpn_offered    TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(alpn_offered)),
    alpn            TEXT,                           -- protocol selected by the server
    ja3             TEXT,
    ja3_hash        TEXT,
    ja4             TEXT,
    compression     INTEGER,                        -- compression method selected by the server
    resumed         INTEGER NOT NULL DEFAULT 0 CHECK (resumed IN (0, 1)),
    outcome         TEXT NOT NULL CHECK (outcome IN ('complete', 'partial')),
    alert_level     INTEGER,                        -- first plaintext alert, if any
    alert_desc      INTEGER,
    alert_from      TEXT CHECK (alert_from IN ('client', 'server')),
    cert_status     TEXT NOT NULL CHECK (cert_status IN ('present', 'encrypted', 'none')),
    cert_count      INTEGER NOT NULL DEFAULT 0,
    leaf_sha256     TEXT,                           -- tls_certificates.sha256 of the leaf
    cert_issues     INTEGER NOT NULL DEFAULT 0      -- bit set over the chain, see netsift-store tls.rs
);

-- index tls_sessions_cert_issues
CREATE INDEX tls_sessions_cert_issues ON tls_sessions (ts, id) WHERE cert_issues != 0;

-- index tls_sessions_cipher_suite
CREATE INDEX tls_sessions_cipher_suite ON tls_sessions (cipher_suite, ts);

-- index tls_sessions_leaf
CREATE INDEX tls_sessions_leaf ON tls_sessions (leaf_sha256);

-- index tls_sessions_server_ip
CREATE INDEX tls_sessions_server_ip ON tls_sessions (server_ip);

-- index tls_sessions_sni
CREATE INDEX tls_sessions_sni ON tls_sessions (sni);

-- index tls_sessions_ts
CREATE INDEX tls_sessions_ts ON tls_sessions (ts, id);

-- index tls_sessions_version
CREATE INDEX tls_sessions_version ON tls_sessions (version, ts);

-- index tls_sessions_weak
CREATE INDEX tls_sessions_weak ON tls_sessions (ts, id) WHERE cipher_weak IS NOT NULL;
