{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetSift",
  "mainBinaryName": "netsift-desktop",
  "identifier": "io.github.tiotbenjy.netsift",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": {
      "script": "npm ci && npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NetSift",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "http://127.0.0.1:* ipc: http://ipc.localhost",
        "img-src": "'self' http://127.0.0.1:* data:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Forensic analysis of network captures",
    "longDescription": "Offline analysis of pcap and pcapng captures, including chunked capture sets.",
    "copyright": "NetSift contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "linux": {
      "deb": {
        "section": "net"
      }
    }
  }
}
